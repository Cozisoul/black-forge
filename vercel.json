{
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "mining.black-forge.co.za"
        }
      ],
      "destination": "/mining/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/mining/:match*",
      "has": [
        {
          "type": "host",
          "value": "black-forge.co.za"
        }
      ],
      "destination": "https://mining.black-forge.co.za/:match*",
      "permanent": true
    }
  ]
}
