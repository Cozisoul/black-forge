---
// src/layouts/MiningLayout.astro
import '../styles/global.css';
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
}
const { title, description, keywords } = Astro.props;

const defaultDescription = 'Black Forge Underground Supply — reliable mining equipment, safety gear, PPE, ventilation, pumps, and tools for underground mining operations in South Africa.';
const defaultKeywords = 'mining supplies South Africa, underground mining equipment, mining PPE supplier, mine safety gear, ventilation products mining, mining tools supplier Johannesburg, mine procurement, mining consumables, Black Forge mining';

const miningJsonLd = {
  "@context": "https://schema.org",
  "@type": "Store",
  "name": "Black Forge Underground Supply",
  "url": "https://mining.black-forge.co.za",
  "logo": "https://black-forge.co.za/bf-logo.png",
  "description": description || defaultDescription,
  "email": "dave@black-forge.co.za",
  "areaServed": {
    "@type": "Country",
    "name": "South Africa"
  },
  "makesOffer": [
    { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Hand Tools & Workshop Equipment" } },
    { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "PPE & Mine Safety Gear" } },
    { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Ventilation Products" } },
    { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Hoses & Fluid Transfer" } },
    { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Pumps & Dewatering Equipment" } },
    { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Electrical & Lighting" } },
    { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Lifting & Rigging" } },
    { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Fasteners & Consumables" } },
    { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Maintenance Support Equipment" } }
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Johannesburg",
    "addressRegion": "Gauteng",
    "addressCountry": "ZA"
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <SEO
      title={title}
      description={description || defaultDescription}
      keywords={keywords || defaultKeywords}
      jsonLd={miningJsonLd}
    />
  </head>
  
  <body class="m-0 p-0 antialiased overflow-x-hidden bg-[#F4F4F4] text-[#000000] selection:bg-[#FFD700] selection:text-black">
    
    <!-- MINING HEADER -->
    <header class="flex justify-between items-center px-4 md:px-6 py-3 md:py-4 border-b border-black bg-[#F4F4F4] sticky top-0 z-50">
      <a href="/mining" class="flex items-center gap-3 md:gap-4 no-underline text-inherit">
        <div class="w-3 h-3 md:w-4 md:h-4 bg-black"></div>
        <div class="font-sans font-bold text-base md:text-xl uppercase tracking-tighter leading-none hidden sm:block">
          BLACK FORGE<br/>
          <span class="font-mono text-[8px] md:text-[10px] tracking-widest text-black/50">UNDERGROUND SUPPLY</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex gap-6 font-mono text-[11px] uppercase tracking-widest">
        <a href="/mining" class="hover:bg-[#FFD700] px-2 py-1 transition-colors">Catalog</a>
        <a href="/mining/procurement" class="hover:bg-[#FFD700] px-2 py-1 transition-colors">Contact</a>
        <a href="/mining/procurement" class="hover:bg-[#FFD700] px-2 py-1 transition-colors border border-black">RFQ_Terminal</a>
      </nav>

      <!-- Mobile Hamburger Button -->
      <button 
        id="mining-menu-btn" 
        class="md:hidden flex flex-col justify-center items-center w-8 h-8 gap-[5px] z-[60] relative"
        aria-label="Toggle menu"
      >
        <span class="mining-bar block w-5 h-[1.5px] bg-black transition-all duration-300 origin-center"></span>
        <span class="mining-bar block w-5 h-[1.5px] bg-black transition-all duration-300 origin-center"></span>
        <span class="mining-bar block w-5 h-[1.5px] bg-black transition-all duration-300 origin-center"></span>
      </button>
    </header>

    <!-- Mobile Menu Overlay -->
    <div id="mining-mobile-menu" class="fixed inset-0 bg-black z-[55] flex flex-col items-center justify-center gap-6 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden">
      <nav class="flex flex-col items-center gap-6">
        <a href="/mining" class="font-sans font-bold text-2xl uppercase tracking-tighter text-white hover:text-[#FFD700] transition-colors">Catalog</a>
        <a href="/mining/procurement" class="font-sans font-bold text-2xl uppercase tracking-tighter text-white hover:text-[#FFD700] transition-colors">Contact</a>
        <a href="/mining/procurement" class="font-mono text-sm uppercase tracking-widest text-[#FFD700] border border-[#FFD700] px-6 py-3 mt-4 hover:bg-[#FFD700] hover:text-black transition-colors">RFQ_Terminal</a>
      </nav>
      <div class="font-mono text-[10px] uppercase tracking-widest text-white/30 mt-8">
        <p>RESTRICTED ACCESS</p>
      </div>
    </div>

    <slot />

    <!-- MINING FOOTER -->
    <footer class="border-t border-black px-4 md:px-6 py-6 md:py-8 bg-black text-white font-mono text-[10px] uppercase">
      <div class="flex flex-col md:flex-row justify-between gap-4 md:gap-0">
        <div>
          <p class="text-[#FFD700] mb-2">DEPENDABLE SUPPLY PARTNER.</p>
          <p class="opacity-50 text-[9px] md:text-[10px] leading-relaxed">SUPPLYING THE TOOLS THAT KEEP UNDERGROUND OPERATIONS MOVING.</p>
        </div>
        <div class="md:text-right opacity-50">
          <p><a href="mailto:dave@black-forge.co.za" class="hover:text-[#FFD700]">DAVE@BLACK-FORGE.CO.ZA</a></p>
          <p class="hidden md:block mt-2">RESTRICTED ACCESS // NOT FOR PUBLIC DISTRIBUTION</p>
        </div>
      </div>
    </footer>

  </body>
</html>

<style is:global>
  :root { font-family: 'Inter', sans-serif; }
  .font-mono { font-family: 'JetBrains Mono', monospace; }
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: #F4F4F4; border-left: 1px solid black; }
  ::-webkit-scrollbar-thumb { background: #000000; }
</style>

<script>
  const btn = document.getElementById('mining-menu-btn');
  const menu = document.getElementById('mining-mobile-menu');
  const bars = btn?.querySelectorAll('.mining-bar') as NodeListOf<HTMLElement> | undefined;
  let open = false;

  btn?.addEventListener('click', () => {
    open = !open;
    if (open) {
      menu?.classList.remove('opacity-0', 'pointer-events-none');
      menu?.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';
      if (bars && bars.length === 3) {
        bars[0].style.transform = 'translateY(3.5px) rotate(45deg)';
        bars[0].style.background = '#FFD700';
        bars[1].style.opacity = '0';
        bars[2].style.transform = 'translateY(-3.5px) rotate(-45deg)';
        bars[2].style.background = '#FFD700';
      }
    } else {
      menu?.classList.add('opacity-0', 'pointer-events-none');
      menu?.classList.remove('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = '';
      if (bars && bars.length === 3) {
        bars[0].style.transform = '';
        bars[0].style.background = '';
        bars[1].style.opacity = '1';
        bars[2].style.transform = '';
        bars[2].style.background = '';
      }
    }
  });

  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      open = false;
      menu?.classList.add('opacity-0', 'pointer-events-none');
      menu?.classList.remove('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = '';
      if (bars && bars.length === 3) {
        bars[0].style.transform = '';
        bars[0].style.background = '';
        bars[1].style.opacity = '1';
        bars[2].style.transform = '';
        bars[2].style.background = '';
      }
    });
  });
</script>
