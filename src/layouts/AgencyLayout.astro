---
// src/layouts/AgencyLayout.astro
import '../styles/global.css';
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
}
const { title, description, keywords } = Astro.props;

const defaultDescription = 'Black Forge is a creative agency in Johannesburg and Pretoria specializing in digital marketing, advertising, brand strategy, scriptwriting, video production, and content creation.';
const defaultKeywords = 'creative agency South Africa, digital marketing Johannesburg, advertising agency Pretoria, brand strategy, scriptwriting, video production, content creation, ATL advertising, BTL marketing, Black Forge';

const agencyJsonLd = {
  "@context": "https://schema.org",
  "@type": "AdvertisingAgency",
  "name": "Black Forge",
  "url": "https://black-forge.co.za",
  "logo": "https://black-forge.co.za/bf-logo.png",
  "description": description || defaultDescription,
  "email": "dave@black-forge.co.za",
  "areaServed": [
    { "@type": "City", "name": "Johannesburg", "containedInPlace": { "@type": "AdministrativeArea", "name": "Gauteng" } },
    { "@type": "City", "name": "Pretoria", "containedInPlace": { "@type": "AdministrativeArea", "name": "Gauteng" } }
  ],
  "knowsAbout": [
    "Digital Marketing", "Digital Advertising", "Brand Strategy",
    "Scriptwriting", "Video Production", "Content Creation",
    "ATL Advertising", "BTL Marketing", "Traditional Media"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Johannesburg",
    "addressRegion": "Gauteng",
    "addressCountry": "ZA"
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <SEO
      title={title}
      description={description || defaultDescription}
      keywords={keywords || defaultKeywords}
      jsonLd={agencyJsonLd}
    />
  </head>
  
  <body class="m-0 p-0 antialiased overflow-x-hidden bg-[#FFF8E7] text-[#050505] selection:bg-[#0044FF] selection:text-[#FFF8E7]">
    
    <!-- AGENCY HEADER -->
    <header class="flex justify-between items-center px-4 md:px-6 py-3 md:py-4 border-b border-black bg-[#FFF8E7] sticky top-0 z-50">
      <a href="/" class="flex items-center gap-3 group cursor-pointer no-underline text-inherit">
        <img src="/bf-logo.png" alt="Black Forge" class="h-6 md:h-8 object-contain" />
        <div class="font-sans font-bold text-base md:text-xl uppercase tracking-tighter leading-none hidden sm:block">
          BLACK FORGE
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex gap-6 font-mono text-[10px] uppercase tracking-widest">
        <a href="/" class="hover:text-[#0044FF] transition-colors">Index</a>
        <a href="/about" class="hover:text-[#0044FF] transition-colors">Culture</a>
        <a href="/contact" class="hover:text-[#0044FF] transition-colors">Contact</a>
      </nav>

      <!-- Mobile Hamburger Button -->
      <button 
        id="agency-menu-btn" 
        class="md:hidden flex flex-col justify-center items-center w-8 h-8 gap-[5px] z-[60] relative"
        aria-label="Toggle menu"
      >
        <span class="agency-bar block w-5 h-[1.5px] bg-black transition-all duration-300 origin-center"></span>
        <span class="agency-bar block w-5 h-[1.5px] bg-black transition-all duration-300 origin-center"></span>
        <span class="agency-bar block w-5 h-[1.5px] bg-black transition-all duration-300 origin-center"></span>
      </button>
    </header>

    <!-- Mobile Menu Overlay -->
    <div id="agency-mobile-menu" class="fixed inset-0 bg-[#FFF8E7] z-[55] flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden">
      <nav class="flex flex-col items-center gap-6">
        <a href="/" class="font-sans font-bold text-3xl uppercase tracking-tighter hover:text-[#0044FF] transition-colors">Index</a>
        <a href="/about" class="font-sans font-bold text-3xl uppercase tracking-tighter hover:text-[#0044FF] transition-colors">Culture</a>
        <a href="/contact" class="font-sans font-bold text-3xl uppercase tracking-tighter hover:text-[#0044FF] transition-colors">Contact</a>
      </nav>
      <div class="font-mono text-[10px] uppercase tracking-widest opacity-40 mt-8">
        <p>JOHANNESBURG // PRETORIA</p>
      </div>
    </div>

    <slot />

    <!-- AGENCY FOOTER -->
    <footer class="border-t border-black px-4 md:px-6 py-8 md:py-12 bg-[#FFF8E7] text-black font-mono text-[10px] uppercase">
      <div class="flex flex-col md:flex-row justify-between gap-6 md:gap-8">
        <div class="flex flex-col gap-2">
          <p class="font-bold text-sm">BLACK FORGE AGENCY</p>
          <p class="opacity-60">JOHANNESBURG // PRETORIA</p>
          <a href="mailto:dave@black-forge.co.za" class="hover:text-[#0044FF] mt-2 block">DAVE@BLACK-FORGE.CO.ZA</a>
        </div>
        <div class="flex gap-8 md:gap-12 opacity-60">
          <div class="flex flex-col gap-2">
            <a href="#" class="hover:text-[#0044FF]">Instagram</a>
            <a href="#" class="hover:text-[#0044FF]">LinkedIn</a>
          </div>
          <div class="flex flex-col gap-2 text-right">
            <a href="#" class="hover:text-black">Privacy Policy</a>
            <p>© 2026 Black Forge.</p>
          </div>
        </div>
      </div>
    </footer>

  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Satoshi';
    src: url('https://cdn.fontshare.com/wf/TTX2Z3MT3LU7KUBLV4G6R4M6ZVK5H45X/7v/woff2') format('woff2');
  }
  :root { font-family: 'Satoshi', sans-serif; }
  .font-mono { font-family: 'Space Mono', monospace; }
  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: #FFF8E7; }
  ::-webkit-scrollbar-thumb { background: #0044FF; }
</style>

<script>
  const btn = document.getElementById('agency-menu-btn');
  const menu = document.getElementById('agency-mobile-menu');
  const bars = btn?.querySelectorAll('.agency-bar') as NodeListOf<HTMLElement> | undefined;
  let open = false;

  btn?.addEventListener('click', () => {
    open = !open;
    if (open) {
      menu?.classList.remove('opacity-0', 'pointer-events-none');
      menu?.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';
      if (bars && bars.length === 3) {
        bars[0].style.transform = 'translateY(3.5px) rotate(45deg)';
        bars[1].style.opacity = '0';
        bars[2].style.transform = 'translateY(-3.5px) rotate(-45deg)';
      }
    } else {
      menu?.classList.add('opacity-0', 'pointer-events-none');
      menu?.classList.remove('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = '';
      if (bars && bars.length === 3) {
        bars[0].style.transform = '';
        bars[1].style.opacity = '1';
        bars[2].style.transform = '';
      }
    }
  });

  // Close menu on link click
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      open = false;
      menu?.classList.add('opacity-0', 'pointer-events-none');
      menu?.classList.remove('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = '';
      if (bars && bars.length === 3) {
        bars[0].style.transform = '';
        bars[1].style.opacity = '1';
        bars[2].style.transform = '';
      }
    });
  });
</script>
