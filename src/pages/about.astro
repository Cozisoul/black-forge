---
// src/pages/about.astro
import AgencyLayout from '../layouts/AgencyLayout.astro';
---

<AgencyLayout title="BLACK FORGE | Who We Are">
  <main class="min-h-[60vh] md:min-h-[70vh] p-5 md:p-12 border-b border-black">
    <div class="max-w-4xl border-l-2 border-[#0044FF] pl-4 md:pl-6 py-3 md:py-4 mb-10 md:mb-12">
      <h1 class="font-sans font-bold text-3xl md:text-5xl uppercase tracking-tighter mb-4 md:mb-6">Who We Are</h1>
      <p class="font-mono text-xs md:text-sm leading-relaxed mb-4 md:mb-6">
        Black Forge is a full-service advertising and brand-building company built for modern businesses that want more than just visibility, they want impact.
      </p>
      <p class="font-mono text-xs md:text-sm leading-relaxed mb-4 md:mb-6">
        We specialize in creating strong, unforgettable brands through a smart mix of digital marketing, digital advertising, scriptwriting, video production, content creation, and traditional media solutions.
      </p>
      <p class="font-mono text-xs md:text-sm leading-relaxed">
        Whether it's a social-first campaign, a TV commercial, a radio script, an outdoor activation, or a full brand launch, we bring ideas to life in ways that move people and move markets.
      </p>
    </div>

    <div class="max-w-4xl border-l-2 border-black pl-4 md:pl-6 py-3 md:py-4">
      <h2 class="font-sans font-bold text-2xl md:text-4xl uppercase tracking-tighter mb-4 md:mb-6">Who We Work With</h2>
      <p class="font-mono text-xs md:text-sm leading-relaxed mb-4 md:mb-6">
        We work with businesses, startups, established brands, and organizations looking to build stronger visibility, better audience connection, and smarter campaigns.
      </p>
      <p class="font-mono text-xs md:text-sm leading-relaxed font-bold text-[#0044FF] mb-8 md:mb-10">
        Whether you're launching something new or refreshing an existing brand, Black Forge is ready to help you make your mark.
      </p>

      <!-- CLIENT LOGOS (Text-based, greyed out) -->
      <div class="flex flex-wrap gap-x-6 md:gap-x-10 gap-y-4 md:gap-y-5 opacity-30">
        <span class="font-sans font-bold text-sm md:text-lg uppercase tracking-tight">Standard Bank</span>
        <span class="font-sans font-bold text-sm md:text-lg uppercase tracking-tight">FNB</span>
        <span class="font-sans font-bold text-sm md:text-lg uppercase tracking-tight">RMB</span>
        <span class="font-sans font-bold text-sm md:text-lg uppercase tracking-tight">MTN</span>
        <span class="font-sans font-bold text-sm md:text-lg uppercase tracking-tight">Mzansi Magic</span>
        <span class="font-sans font-bold text-sm md:text-lg uppercase tracking-tight">Mzansi Bioscope</span>
        <span class="font-sans font-bold text-sm md:text-lg uppercase tracking-tight">Mzansi Wethu</span>
        <span class="font-sans font-bold text-sm md:text-lg uppercase tracking-tight">Mr D</span>
        <span class="font-sans font-bold text-sm md:text-lg uppercase tracking-tight">Takealot</span>
        <span class="font-sans font-bold text-sm md:text-lg uppercase tracking-tight">Simba</span>
        <span class="font-sans font-bold text-sm md:text-lg uppercase tracking-tight">MultiChoice</span>
        <span class="font-sans font-bold text-sm md:text-lg uppercase tracking-tight">ABSA</span>
        <span class="font-sans font-bold text-sm md:text-lg uppercase tracking-tight">Nando's</span>
        <span class="font-sans font-bold text-sm md:text-lg uppercase tracking-tight">Home Connect</span>
        <span class="font-sans font-bold text-sm md:text-lg uppercase tracking-tight">Anglo American</span>
      </div>
    </div>
  </main>
  
  <section class="bg-black text-[#FFF8E7] p-5 md:p-12 text-center">
      <h2 class="font-sans font-bold text-2xl md:text-4xl uppercase tracking-tighter mb-3 md:mb-4">Let's Build Something Bold</h2>
      <p class="font-mono text-xs md:text-sm mb-6 md:mb-8 opacity-80 max-w-xl mx-auto">Your brand deserves more than ordinary. Let's create campaigns that turn heads, tell stories, and deliver results.</p>
      <a href="/contact" class="inline-block border border-[#FFF8E7] px-6 md:px-8 py-3 md:py-4 font-mono text-[10px] md:text-xs uppercase tracking-widest hover:bg-[#0044FF] hover:border-[#0044FF] transition-colors">
        Let's talk
      </a>
  </section>
</AgencyLayout>
